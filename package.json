{
  "name": "rera-resolver",
  "version": "0.1.0",
  "description": "Standalone library that resolves messy Karnataka RERA project names to registry records, with a tiered deterministic/LLM matcher.",
  "license": "MIT",
  "author": "Shiva V",
  "keywords": [
    "rera",
    "karnataka",
    "real-estate",
    "name-resolution",
    "fuzzy-matching"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vsrkrishnan/rera-resolver.git"
  },
  "homepage": "https://github.com/vsrkrishnan/rera-resolver#readme",
  "bugs": {
    "url": "https://github.com/vsrkrishnan/rera-resolver/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "rera-resolver": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "postinstall": "node dist/postinstall.js || true",
    "sync": "RERA_RESOLVER_DB_DIR=data tsx scripts/sync.ts",
    "measure": "RERA_RESOLVER_DB_DIR=data tsx scripts/measure.ts",
    "test": "node --import tsx --test src/__tests__/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
